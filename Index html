/* =================================================
   BIDAK
================================================= */

const symbols={

    wp:"♙",
    wr:"♖",
    wn:"♘",
    wb:"♗",
    wq:"♕",
    wk:"♔",

    bp:"♟",
    br:"♜",
    bn:"♞",
    bb:"♝",
    bq:"♛",
    bk:"♚"

};


const value={

    p:100,
    n:320,
    b:330,
    r:500,
    q:900,
    k:20000

};



/* =================================================
   STATE
================================================= */

let board;

let selected=null;

let turn="w";

let gameOver=false;

let lastMove=null;

let moveHistory=[];

let replayMoves=[];

let replayBoard=null;

let replayIndex=0;

let replayTimer=null;

let replayPlaying=false;



/* =================================================
   BOARD AWAL
================================================= */

function createInitialBoard(){

    return [

        [
            "br",
            "bn",
            "bb",
            "bq",
            "bk",
            "bb",
            "bn",
            "br"
        ],

        [
            "bp",
            "bp",
            "bp",
            "bp",
            "bp",
            "bp",
            "bp",
            "bp"
        ],

        [
            null,null,null,null,
            null,null,null,null
        ],

        [
            null,null,null,null,
            null,null,null,null
        ],

        [
            null,null,null,null,
            null,null,null,null
        ],

        [
            null,null,null,null,
            null,null,null,null
        ],

        [
            "wp",
            "wp",
            "wp",
            "wp",
            "wp",
            "wp",
            "wp",
            "wp"
        ],

