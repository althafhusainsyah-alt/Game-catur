/* =================================================
   GAME BARU
================================================= */

function newGame(){

    stopReplay();


    board=
        createInitialBoard();


    selected=null;

    turn="w";

    gameOver=false;

    lastMove=null;

    moveHistory=[];

    replayMoves=[];


    document
    .getElementById(
        "replayBox"
    )
    .classList.remove(
        "show"
    );


    document
    .getElementById(
        "resultOverlay"
    )
    .classList.remove(
